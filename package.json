{
  "name": "halopsa",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean:docs": "npx rimraf docs/",
    "clean:generator": "npx rimraf generator/temp/*.ts",
    "clean:dist": "npx rimraf dist/",
    "clean:src": "npx rimraf src/HaloPSA/",
    "clean": "npm run clean:dist && npm run clean:generator && npm run clean:src",
    "pretest": "npm run build",
    "test": "npm run test:types && npx nyc mocha test/test-halo.mjs",
    "test:types": "npx tsc --noEmit -p test",
    "pregenerate": "npm run clean",
    "generate": "node generator/halopsa-generator.js",
    "prebuild": "npm run generate",
    "build": "npx tsc",
    "lint": "npx eslint src --fix --cache --cache-location node_modules/.cache/eslint/",
    "coveralls": "npx nyc report --reporter=text-lcov > ./.nyc_output/lcov.info",
    "predocs": "npm run clean:docs",
    "docs": "npx typedoc src/index.ts",
    "preapidocumenter": "npx api-extractor run --local --verbose",
    "apidocumenter": "npx api-documenter markdown --input-folder temp --output-folder docs",
    "gh-pages": "npx gh-pages -d docs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.15.0",
    "promise-retry": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-documenter": "^7.30.0",
    "@microsoft/api-extractor": "^7.58.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/promise-retry": "^1.1.6",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "expect-type": "^1.3.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.5.0",
    "lodash": "^4.18.1",
    "mocha": "^11.7.5",
    "mocha-lcov-reporter": "^1.3.0",
    "nyc": "^18.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.2",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1"
  }
}
